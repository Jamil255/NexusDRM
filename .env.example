# Application
APP_NAME=DRMS
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=drms_user
DB_PASSWORD=drms_password
DB_DATABASE=drms_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=drms-raw-content
S3_BUCKET_ENCRYPTED=drms-encrypted-content
S3_BUCKET_THUMBNAILS=drms-thumbnails
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# PgBoss
PGBOSS_SCHEMA=pgboss
PGBOSS_ARCHIVE_INTERVAL_DAYS=7

# Encryption
MASTER_ENCRYPTION_KEY=your-256-bit-master-key-change-in-production
CONTENT_ENCRYPTION_ALGORITHM=aes-256-gcm

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000

# CDN
CDN_BASE_URL=https://cdn.example.com
CDN_SIGNING_KEY=your-cdn-signing-key

# Email (for notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@drms.com

# Signed URL
SIGNED_URL_DEFAULT_TTL=900
SIGNED_URL_STREAM_TTL=3600
